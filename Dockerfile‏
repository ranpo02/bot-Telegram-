# 1. استخدام صورة بايثون رسمية كأساس
FROM python:3.10-slim

# 2. تعيين مجلد العمل داخل الحاوية
WORKDIR /app

# 3. تثبيت ffmpeg (مهم جدًا لـ yt-dlp)
#    نستخدم apt-get لتثبيت برامج على مستوى النظام
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

# 4. نسخ ملف المتطلبات أولاً (للاستفادة من التخزين المؤقت لـ Docker)
COPY requirements.txt .

# 5. تثبيت مكتبات بايثون
RUN pip install --no-cache-dir -r requirements.txt

# 6. نسخ كل كود المشروع إلى الحاوية
COPY . .

# 7. الأمر الذي سيتم تشغيله عند بدء تشغيل الحاوية
CMD ["python", "run.py"]
